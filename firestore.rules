rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya email yang terdaftar di Firebase Authentication DAN ada di daftar ini yang boleh baca/tulis.
    // Tambahkan email trainer lain ke dalam daftar bila perlu.
    match /trainings/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['onboarding.zahirtrainer@gmail.com'];
    }
  }
}
